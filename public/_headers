# Netlify / Cloudflare Pages response headers.

/*
  # Tell browsers to reach this origin over HTTPS for the next two years, and
  # make the site eligible for the HSTS preload list. Only enable preload once
  # every subdomain is confirmed HTTPS-only — it is hard to reverse.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Vite fingerprints every file in /assets, so they can be cached permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is rewritten on each deploy and must always be revalidated, or visitors
# keep seeing the previous build's markup and metadata.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/og-image.jpg
  Cache-Control: public, max-age=604800
